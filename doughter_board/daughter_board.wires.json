 "notes": [
  {
   "x": 700,
   "y": 2100,
   "text": "Power daughter board for LilyGo T-Display-S3 AMOLED Plus (UHK BLE adapter)"
  },
  {
   "x": 700,
   "y": 1950,
   "text": "J1: USB-C sink, Rd 5.1k on CC1/CC2 -> any USB port / charger gives 5 V. D+/D- held low (15k): a PC sees nothing attached, no 'unknown device' / port errors."
  },
  {
   "x": 700,
   "y": 1800,
   "text": "F1: Bourns MF-MSMF110-2, 1.1 A hold / 2.2 A trip, 6 V, 1812. LilyGo + UHK draw < 1 A."
  },
  {
   "x": 700,
   "y": 1650,
   "text": "C3/C4: KEMET T491B106K016AT (10uF 16V, B) / T491A105K025AT (1uF 25V, A) right at the LilyGo VBUS pins; 3-5x voltage derating for hot-plug surge."
  },
  {
   "x": 700,
   "y": 1500,
   "text": "H1/H2: 1x4 2.54 mm female sockets onto the LilyGo headers, pins 11-14 of each row; rows 22.86 mm (900 mil) apart. Only GND and VBUS are connected; 3V3, VBAT, IO16, IO39 are for mechanical grip only."
  },
  {
   "x": 700,
   "y": 1350,
   "text": "Never plug the LilyGo's own USB-C into a PC while this board feeds VBUS: same net."
  }
 ],
 "target": "Sheet1.SchDoc"
